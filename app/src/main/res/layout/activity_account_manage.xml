<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark"
    tools:context=".AccountManageActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Platforma"
            android:textAllCaps="true"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/et_platform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="np. YouTube"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/light" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Login"
            android:textAllCaps="true"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/et_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="Twój login"
            android:inputType="text"
            android:textColor="@color/white"
            android:textColorHint="@color/light" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Hasło"
            android:textAllCaps="true"
            android:textColor="@color/white" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColorHint="@color/light"
            android:padding="0dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/white"
            app:hintEnabled="false"

            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="@android:color/transparent"
            app:boxStrokeColor="@android:color/black"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/dark"
                android:hint="Twoje hasło"
                android:inputType="textPassword"
                android:padding="0dp"
                android:paddingStart="4dp"
                android:textColor="@color/white"
                android:textColorHint="@color/light" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zapisz zmiany" />

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/design_default_color_error"
            android:text="Usuń konto" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>